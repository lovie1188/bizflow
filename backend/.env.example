# BizFlow Backend – Environment Variables
# Copy this file to .env and fill in your actual values
#
# ⚠️  SECURITY WARNING:
#   - NEVER commit your .env file to git
#   - NEVER hardcode real credentials in source code
#   - Use Gmail App Passwords (not your main password)
#   - Rotate JWT_SECRET periodically
#   - For production: use your hosting platform's env var management

NODE_ENV=development
PORT=5000

# PostgreSQL (Neon or local)
DATABASE_URL=postgresql://user:password@host:5432/bizflow_db?sslmode=require

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_hex_string_here
JWT_EXPIRE=30d

# Razorpay Payments (use live keys in production)
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=rzp_test_secret_xxxxxxxxxxxx

# Frontend URL (CORS)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer SMTP) ────────────────────────────────────────
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=you@gmail.com
# Use Gmail App Password (not your account password)
# Zoho: EMAIL_HOST=smtp.zoho.in, EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM_NAME=BizFlow India

# ─── WhatsApp (Twilio) ──────────────────────────────────────────────
# Get keys from https://console.twilio.com
# WhatsApp Business Sandbox: +14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# ─── Google Drive ────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
