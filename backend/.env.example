# BizFlow Backend – Environment Variables
# Copy this file to .env and fill in your actual values

NODE_ENV=development
PORT=5000

# PostgreSQL (Neon or local)
DATABASE_URL=postgresql://user:password@host:5432/bizflow_db?sslmode=require

# JWT
JWT_SECRET=your_secret_key_min_32_chars_long_here
JWT_EXPIRE=30d

# Razorpay Payments
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=rzp_test_secret_xxxxxxxxxxxx

# Frontend URL (CORS)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_key_here
